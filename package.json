{
  "name": "gio4x-june-2026",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portal": "npm --workspace apps/portal run dev",
    "build:portal": "npm --workspace apps/portal run build",
    "dev:raptor": "npm --workspace apps/raptor run dev",
    "build:raptor": "npm --workspace apps/raptor run build",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "patch:portal-handler": "node scripts/patch-netlify-handler-paths.mjs apps/portal",
    "deploy:portal": "netlify build --filter @gio4x/portal && node scripts/patch-netlify-handler-paths.mjs apps/portal && netlify deploy --prod --filter @gio4x/portal --no-build --skip-functions-cache"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
