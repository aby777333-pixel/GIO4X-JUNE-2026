{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@gio4x/ui": ["packages/ui/src/index.ts"],
      "@gio4x/ui/*": ["packages/ui/src/*"],
      "@gio4x/supabase": ["packages/supabase/src/index.ts"],
      "@gio4x/supabase/*": ["packages/supabase/src/*"],
      "@gio4x/config/*": ["packages/config/*"]
    }
  }
}
